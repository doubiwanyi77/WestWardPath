-- 服务节点：账号 / 以后的对局。不听 WebSocket，不服务网页。
skynet_root = "/home/zp/skynet/"

thread = 8
logger = nil
harbor = 0
start = "service_node"
bootstrap = "snlua bootstrap"
lualoader = skynet_root .. "lualib/loader.lua"
luaservice = "./service/?.lua;" .. skynet_root .. "service/?.lua"
lua_path = "./lualib/?.lua;" .. skynet_root .. "lualib/?.lua;" .. skynet_root .. "lualib/?/init.lua"
lua_cpath = skynet_root .. "luaclib/?.so"
cpath = skynet_root .. "cservice/?.so"

node_name = "service_node"
cluster_host = "127.0.0.1"
cluster_port = "2529"

mysql_host = "127.0.0.1"
mysql_port = "3306"
mysql_user = "westwardpath2"
mysql_password = "westwardpath2"
mysql_database = "westwardpath2"

redis_host = "127.0.0.1"
redis_port = "6379"
redis_db = "0"
